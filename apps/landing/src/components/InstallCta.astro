---
// The compact install pill. Without JS it is selectable text; the button copies it.
const prompt = "install open-bus.ai/llms.txt";
---

<div class="cta compact">
  <p class="cta-label">Get your own bus. Tell your agent:</p>
  <div class="cta-row">
    <code class="cta-prompt">install <span class="nowrap">open-bus.ai/llms.txt</span></code>
    <button class="btn primary" type="button" data-copy={prompt}>
      <span data-idle>Copy</span><span data-done hidden>Copied</span>
    </button>
  </div>
  <p class="cta-note" role="status" aria-live="polite">Your agent does the setup. Your bus, in minutes.</p>
</div>

<script>
  // Copy button (open-artifacts.com Landing.astro).
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const idle = button.querySelector<HTMLElement>("[data-idle]");
    const done = button.querySelector<HTMLElement>("[data-done]");
    const note = button.closest(".cta")?.querySelector<HTMLElement>(".cta-note");
    if (!idle || !done || !note) continue;
    const initial = note.textContent ?? "";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        idle.hidden = true;
        done.hidden = false;
        note.textContent = "Copied. Paste it into your agent.";
        note.classList.add("done");
        setTimeout(() => {
          idle.hidden = false;
          done.hidden = true;
          note.textContent = initial;
          note.classList.remove("done");
        }, 2000);
      } catch {
        note.textContent = "Copy failed. Select the text and copy it by hand.";
      }
    });
  }
</script>
