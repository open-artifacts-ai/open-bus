{
  // Staging Worker. deploy-staging.yml overrides APP_HOST and VERSION with --var, and
  // passes OWNER_EMAIL, ACCESS_TEAM_DOMAIN and ACCESS_CLIENT_ID with --var too (they are
  // not listed here). ACCESS_CLIENT_SECRET and SESSION_SECRET are Worker secrets.
  // HUB is the Hub Durable Object binding (B3).
  "name": "open-bus-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "staging.open-bus.ai", "custom_domain": true }],
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_HOST": "staging.open-bus.ai",
    "VERSION": "dev",
    "ENVIRONMENT": "production"
  },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Per-IP limits; the code fails open when unbound. namespace_id is
  // account-wide: these are staging's; setup gives installs 3001/3002
  // (INSTALL_RATELIMITS in scripts/setup/src/steps/deploy.ts).
  "ratelimits": [
    {
      "name": "RL_AUTH",
      "namespace_id": "2002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_DEVICE",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
