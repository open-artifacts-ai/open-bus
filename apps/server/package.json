{
  "name": "@ob/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:e2e": "wrangler dev -c wrangler.e2e.jsonc --port 8787 --ip 127.0.0.1",
    "dev:e2e:reset": "node -e \"require('node:fs').rmSync('.wrangler/state',{recursive:true,force:true})\"",
    "test": "pnpm --filter @ob/shared build && vitest run && vitest run -c vitest.node.config.ts",
    "test:pinned": "pnpm --filter @ob/shared build && node scripts/test-pinned.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ob/shared": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  }
}
