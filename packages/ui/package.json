{
  "name": "@ob/ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./fonts.css": "./src/tokens/fonts.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./shadcn": "./src/shadcn/index.ts",
    "./shadcn.css": "./src/shadcn/shadcn.css",
    "./shadcn-utilities.css": "./src/shadcn/shadcn-utilities.css",
    "./composites": "./src/composites/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
