    "@ob/daemon": "workspace:*",
    "@ob/ipc": "workspace:*",
    "@ob/shared": "workspace:*",
    "@ob/ui": "workspace:*",
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.1.0"
  }
